# Energy School — Variables de Entorno (MQTT Bridge)
# En Render: configúralas en el panel "Environment Variables".
# En local: copia como .env y rellena los valores.

# Supabase (Settings > API > service_role key)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu_service_role_key

# HiveMQ Cloud (Cluster > Access Management)
MQTT_URL=mqtts://tu-cluster.hivemq.cloud:8883
MQTT_USERNAME=tu_usuario_hivemq
MQTT_PASSWORD=tu_password_hivemq

# Render inyecta PORT automáticamente. Solo cambiar en desarrollo local.
PORT=3000

# Niveles: debug, info, warn, error
LOG_LEVEL=info
